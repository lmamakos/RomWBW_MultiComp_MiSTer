; io-cpm.azm


; CP/M TERMINAL I/O =============================
cpmbdos EQU 5h          ; CP/M BDOS entry point

;Z BDOS   de c -- a   call CP/M BDOS
    head BDOS,4,'BDOS',docode
        ex de,hl    ; save important Forth regs
        pop de      ;  (DE,IX,IY) & pop DE value
        push hl
        push ix
        push iy
        call cpmbdos
        ld c,a      ; result in TOS
        ld b,0
        pop iy      ; restore Forth regs
        pop ix
        pop de
        next

;C EMIT     c --    output character to console
;   6 BDOS DROP ;
; warning: if c=0ffh, will read one keypress
    head EMIT,4,'EMIT',docolon
        DW LIT,06H,BDOS,DROP,EXIT

;Z SAVEKEY  -- addr  temporary storage for KEY?
    head savekey,7,'SAVEKEY',dovar
        DW 0

;X KEY?     -- f    return true if char waiting
;   0FF 6 BDOS DUP SAVEKEY C! ;   rtns 0 or key
; must use BDOS function 6 to work with KEY
    head querykey,4,'KEY?',docolon
        DW LIT,0FFH,LIT,06H,BDOS
        DW DUP,SAVEKEY,CSTORE,EXIT

;C KEY      -- c    get character from keyboard
;   BEGIN SAVEKEY C@ 0= WHILE KEY? DROP REPEAT
;   SAVEKEY C@  0 SAVEKEY C! ;
; must use CP/M direct console I/O to avoid echo
; (BDOS function 6, contained within KEY?)
    head KEY,3,'KEY',docolon
KEY1:   DW SAVEKEY,CFETCH,ZEROEQUAL,qbranch,KEY2
        DW QUERYKEY,DROP,branch,KEY1
KEY2:   DW SAVEKEY,CFETCH,LIT,0,SAVEKEY,CSTORE
        DW EXIT

;Z CPMACCEPT  c-addr +n -- +n'  get line of input
;   SWAP 2 - TUCK C!      max # of characters
;   DUP 0A BDOS DROP      CP/M Get Console Buffer
;   1+ C@  0A EMIT ;      get returned count
; Note: requires the two locations before c-addr
; to be available for use.
    head CPMACCEPT,9,'CPMACCEPT',docolon
        DW SWOP,LIT,2,MINUS,TUCK,CSTORE
        DW DUP,LIT,0Ah,BDOS,DROP
        DW ONEPLUS,CFETCH,LIT,0Ah,EMIT,EXIT

;X BYE     i*x --    return to CP/M
    head bye,3,'bye',docode
        jp 0

; ------------------------------------------------------------------
; CP/M constants
BD$OPEN    EQU 15	; open file
BD$CLOSE   EQU 16 	; close file 
BD$CREATE  EQU 22	; create file	
BD$SETDMA  EQU 26	; set DMA (I/O transfer address
BD$RDRND   EQU 33	; read random
BD$WRRND   EQU 34	; write random
BD$SETRR   EQU 36	; set random record number 
BD$WRRNDZ  EQU 40	; write random with zero-fill
; BD$SMSCNT (function 44, "set multi-sector count") is a CP/M 3.x-only
; BDOS call and is NOT available under CP/M 2.2.  It is intentionally
; unused below -- see file$io, which instead loops over 8 individual
; 128-byte CP/M records to move one 1024-byte FORTH block, so that the
; same driver works unmodified on both CP/M 2.2 and CP/M 3.0.
BD$SMSCNT  EQU 44	; set multi-sector count CP/M 3.x (unused, see above)

; ------------------------------------------------------------------
; CP/M low-level I/O words to CP/M file system
;
;  8 char name, 3 char "type"
;              '12345678'
block$name: db 'FORTH   '  ; EXACTLY 8 charactersxsxsxsxsxsxsx
            db 'BLK'       ; EXACTLY 3 characters
            IF $-block$name NE 11
            DB $-block$name
            COMMENT |CP/M File Name wrong length|
            DS CP/M File Name wrong length
            ENDIF

; define space for single CP/M FCB to do this simple I/O
fcb$buf:  DS 40
  head fcb$,4,'FCB$',docon
    dw fcb$buf

  head open$file,9,'open-file',docolon
    dw fcb$,LIT,36,LIT,0,FILL  ; zero out the FCB

    dw LIT,block$name, fcb$, LIT, 1, PLUS, LIT,11
    dw CMOVE    ; copy in the file name

    dw fcb$, LIT,BD$OPEN, BDOS ; BDOS open
    dw DROP   ; probably should check the return status..
    dw EXIT

; file-io  ( operation block# buffer-adr -- status )
;   Transfer one 1024-byte FORTH block between 'buffer-adr' and the
;   open block file, using CP/M's random-access record I/O.  'operation'
;   is the BDOS function to use for each record: BD$RDRND, BD$WRRND, or
;   BD$WRRNDZ.
;
;   CP/M 2.2 has no multi-sector I/O call (that's a CP/M 3.x-only
;   feature -- see BD$SMSCNT above), so a 1024-byte FORTH block is
;   moved as EIGHT separate 128-byte CP/M records instead: seek once to
;   the base record (block# * 8), then loop 8 times, each pass setting
;   the DMA address to the next 128-byte slice of the buffer, doing one
;   BDOS random-I/O call, and bumping the FCB's random record number by
;   one for the next pass.  This works unchanged on CP/M 2.2 and 3.0.
  head file$io,7,'io-file',docolon
    dw SWOP, file$seek          ; ( operation buffer-adr )  FCB rec# := block#*8
    dw LIT,8, LIT,0, XDO        ; do 8 records, I = 0..7
FIO1:
    dw DUP, II, LIT,80h, STAR, PLUS     ; ( op buf sector-addr )  buf + I*128
    dw LIT,BD$SETDMA, BDOS, DROP        ; set DMA to this 128-byte slice
    dw OVER, FCB$, SWOP, BDOS, DROP     ; do the 128-byte record I/O
    dw FCB$, LIT,33, PLUS               ; ( op buf addr-of-fcb-rec# )
    dw DUP, FETCH, ONEPLUS, SWOP, STORE ; bump FCB rec# for the next pass
    dw XLOOP,FIO1
    dw TWODROP, LIT,0                   ; caller ignores status; return 0
    dw EXIT

; seek-file  ( block-num -- )
  head file$seek,9,'seek-file',docolon
    dw LIT,3, LSHIFT    ; multiply block number by 8 for CPM rec#
    dw FCB$, LIT,33, PLUS, STORE       ; store CP/M rec into FCB random rec#
    dw LIT,0, LIT,35, fcb$, PLUS, CSTORE     ; zero record extension
    dw EXIT

; read-file
  head read$file,9,'read-file',docolon
    dw LIT,BD$RDRND, ROT, ROT, file$io
    dw DROP  ; ignore status
    dw EXIT

; write-file
  head write$file,10,'write-file',docolon
    dw LIT,BD$WRRNDZ, ROT, ROT, file$io
    dw DROP  ; ignore status    
    dw EXIT


; load - load and evaluate a block from the (open)
;        block file.   Pretty bare-bones and expected
;        to be replaced by a more sophisticated version
;        from the FORTH environment extended after loading
;
; Uses BLKBUF (see camel80h.azm), the dynamically-allocated one-block
; transfer buffer, rather than a hard-coded address.
;
;     HEX
;     : LOAD (blocknum -- ) open-file BLKBUF @ read-file
;       10 0 DO BLKBUF @ I 40 * + 40 2DUP CR BASE @ DECIMAL I . BASE ! 3E EMIT
;       SPACE TYPE EVALUATE LOOP ;
  head load$extend,4,'LOAD',docolon
    DW open$file
    DW BLKBUF,FETCH, read$file
    DW LIT,10h, LIT,0, XDO
LOAD1:
    DW BLKBUF,FETCH, II
    DW LIT,40h, STAR, PLUS, LIT,40h
 IF 0  ; print each line as it's evaulated
    DW TWODUP
    DW CR
    DW BASE, FETCH, DECIMAL, II, DOT, BASE, STORE
    DW LIT,3Eh, EMIT, SPACE, TYPE
 ENDIF
    DW EVALUATE
    DW XLOOP,LOAD1
    DW EXIT

; boot - load first two blocks from the blocks file to boostrap
;        additional words into the forth environment.  The
;        code in the first block can load additional blocks
;        very carefully..
  head bootextend,4,'INIT',docolon
    DW LIT,0,load$extend, LIT,1,load$extend, EXIT
